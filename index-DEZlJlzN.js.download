oText:"INTERNSHALA",color:"from-sky-500 to-blue-600",description:"Led technical SEO platform architecture and scaled programmatic landing pages across double-sided B2C (students) and B2B (employers) marketplace funnels.",achievements:["Executed Programmatic SEO (pSEO) strategy scaling thousands of dynamic landing pages targeting high-intent non-branded student search queries.","Overhauled site architecture and crawl efficiency for Internshala's core platform, drastically improving indexation speed for newly posted internships.","Spearheaded SEO for Internshala Blogs, hackathons, and student competitions, capturing #1 rankings for high-volume career queries.","Engineered full-funnel App Store Optimization (ASO) strategy, optimizing title, subtitle, keyword bank, and visual screenshots to accelerate mobile app downloads.","Collaborated with product, marketing, and design teams to optimize conversion rate optimization (CRO) on high-traffic landing pages."],skills:["Programmatic SEO (pSEO)","Marketplace Architecture","B2B & B2C SEO","App Store Optimization (ASO)","Crawl Budget Optimization"]},{company:"Mobile Premier League (MPL)",role:"Associate SEO & ASO",period:"Jan 2025 – Jan 2026",badge:"Gaming Unicorn",current:!1,logoText:"MPL",color:"from-red-500 to-amber-600",description:"Managed end-to-end SEO and ASO for MPL's high-stakes cricket segment, including MPL Cricket, Fantasy Cricket, Cricket Opinion, and Cricket 100x.",achievements:["Built the MPL Cricket vertical from absolute scratch to 130,000+ monthly organic visits in just 3 months through aggressive programmatic execution.","Led Core Web Vitals (CWV) optimization across MPL Core and MPL Cricket, improving page load speeds by 40% and unlocking massive ranking boosts.","Executed 20+ A/B conversion tests on Google Play and Apple App Store across India, United States, Brazil, and OEM stores.","Implemented comprehensive Apple Search Ads (ASA) and keyword research frameworks to dominate competitive real-money gaming SERPs.","Deployed automated programmatic content pipelines covering every match, tournament, and fantasy prediction without algorithmic penalty."],skills:["Gaming SEO","Core Web Vitals","Multi-Country ASO","Apple Search Ads","Programmatic Cricket Architecture","130K Traffic in 90 Days"]},{company:"Sportskeeda",role:"SEO Intern",period:"Jan 2024 – Jan 2025",badge:"Sports Media Giant",current:!1,logoText:"SPORTSKEEDA",color:"from-emerald-500 to-teal-600",description:"Managed organic visibility across global sports categories, dominating real-time trending queries, Google Discover feeds, and Google News carousels.",achievements:["Boosted organic traffic by +25% across covered sports categories through strategic on-page execution and real-time live content optimization.","Secured prominent placements in Google News and Google Discover for high-velocity international sporting tournaments.","Conducted rigorous technical audits, resolved crawl anomalies, and enforced strict internal linking guidelines across editorial teams.","Developed competitor gap benchmarking models using GA4 and Search Console to identify untapped sports keywords ahead of major events."],skills:["Google Discover Optimization","Google News SEO","Real-Time Event SEO","Editorial Link Building","Competitor Gap Analysis"]}],$u=[{id:"pseo",title:"Programmatic SEO (pSEO)",badge:"Scale 10,000+ Pages",icon:"Database",shortDesc:"Generate thousands of high-intent, indexable landing pages targeting long-tail buyer queries without scaling editorial headcount.",fullDesc:"Programmatic SEO is the art and science of leveraging structured datasets to construct index-ready, helpful landing pages at scale. Having executed pSEO at both Internshala and MPL, I build automated URL taxonomies, dynamic schema, and anti-cannibalization protections that Google enthusiastically indexes.",deliverables:["Dataset architecture & keyword modifier matrix","Dynamic template engineering with unique value-add modules","Internal linking mesh to distribute link equity seamlessly","Crawl budget optimization & XML sitemap segmentation","Anti-thin-content and Google Helpful Content safety guardrails"],idealFor:"E-commerce catalogs, marketplaces, job portals, aggregators, and SaaS platforms."},{id:"geo-aeo",title:"Generative Engine Optimization (GEO) & AEO",badge:"AI Search Ready",icon:"Bot",shortDesc:"Engineer your brand to get cited and recommended by ChatGPT, Perplexity, Claude, Gemini, and Google AI Overviews.",fullDesc:"Over 35% of informational and transactional queries are now answered directly by Large Language Models (LLMs) and AI search engines. I structure your digital footprint into unambiguous entity nodes, configure /llms.txt, and build authoritative brand citations so generative engines retrieve your business first.",deliverables:["Brand entity registration in Wikidata & Google Knowledge Graph","/llms.txt and markdown documentation for AI crawler accessibility","Answer Engine Optimization (AEO) for Google AI Overviews & Featured Snippets","LLM citation tracking and sentiment audit across ChatGPT & Perplexity","Structured Schema.org microdata (FAQPage, HowTo, DefinedTerm, Merchant)"],idealFor:"Brands seeking to future-proof customer acquisition as search moves to conversational AI."},{id:"aso",title:"App Store Optimization (ASO)",badge:"App Store & Google Play",icon:"Smartphone",shortDesc:"Maximize app discoverability, organic keyword ranks, and store listing conversion rates across iOS and Android.",fullDesc:"With hands-on experience scaling downloads for MPL and Internshala across India, the US, and Brazil, I run rigorous scientific store listing experiments. Combining creative asset testing with deep keyword localization, I turn store visitors into active installs.",deliverables:["Comprehensive App Store keyword research (search volume vs difficulty)","20+ A/B experiments for icons, screenshots, promo videos & subtitles","Custom Product Pages (CPP) & Store Listing Experiments (SLE)","Apple Search Ads (ASA) synergy for organic ranking velocity","Cross-border localization for international app store deployment"],idealFor:"Mobile games, consumer apps, fintech, and e-commerce mobile applications."},{id:"ecommerce",title:"E-Commerce Collection Architecture",badge:"High-Intent Revenue",icon:"ShoppingBag",shortDesc:"Transform category and collection pages into revenue engines that capture high-intent commercial and transactional queries.",fullDesc:"Collection pages drive over 70% of e-commerce organic revenue. Currently spearheading SEO at GIVA, I design clean category hierarchies, resolve facet URL bloat, and inject contextual buyer guides that educate shoppers while satisfying algorithmic quality thresholds.",deliverables:["Faceted navigation audit (canonical vs noindex vs robots.txt)","Collection-page content architecture (buying guides, FAQs, styling tips)","Product-to-Category internal link equity distribution","Merchant Center product structured data & Google Shopping optimization","Dynamic out-of-stock and seasonal product redirect management"],idealFor:"D2C brands, luxury retail, fashion, jewellery, and high-SKU online storefronts."},{id:"technical",title:"Technical SEO & Core Web Vitals",badge:"Sub-Second LCP",icon:"Cpu",shortDesc:"Eradicate crawl bottlenecks, resolve JavaScript rendering discrepancies (SSR vs CSR), and hit 90+ Core Web Vitals.",fullDesc:"Grounding in Information Technology engineering allows me to converse fluently with development teams. I diagnose log files, optimize critical rendering paths, resolve duplicate canonical traps, and ensure web apps pass Google's real-user Core Web Vitals (INP, LCP, CLS).",deliverables:["Server-side rendering (SSR) vs client-side rendering (CSR) audit","Server log file analysis to inspect Googlebot crawl behavior","Core Web Vitals remediation (LCP, INP, CLS sub-second tuning)","JavaScript rendering inspection and DOM hydration analysis","Advanced robots.txt, canonicalization, and XML sitemap architecture"],idealFor:"React/Next.js/Vue web applications, high-traffic portals, and enterprise websites."},{id:"news-discover",title:"Google Discover & Real-Time Search",badge:"+25% Traffic Surge",icon:"TrendingUp",shortDesc:"Capture millions of impressions through Google Discover feeds and Google News carousels during high-velocity events.",fullDesc:"Proven at Sportskeeda, Google Discover can generate explosive traffic surges when editorial content aligns with Google's entity affinity graph. I train content teams on schema speed, high-CTR visual framing, and entity freshness signals to trigger Discover recommendations.",deliverables:["Google Discover entity mapping and visual format optimization","Google News inclusion criteria and live blogging schema implementation","High-CTR headline and image aspect-ratio guidelines","Real-time search trend monitoring (Google Trends + GSC API)","Competitor topic gap analysis for immediate editorial execution"],idealFor:"Media publications, sports portals, entertainment brands, and trending content sites."}],Hu=[{id:"mpl-cricket",company:"Mobile Premier League (MPL)",tagline:"Building a Cricket SEO Engine from Scratch to 130K+ Monthly Visits in 90 Days",metricHero:"130K+",metricLabel:"Monthly Organic Visits in 3 Months",timeframe:"Jan 2025 - Jan 2026",overview:"MPL needed to establish dominant organic search ownership over cricket and fantasy sports keywords ahead of the peak tournament season without relying entirely on paid acquisition.",problem:"The domain lacked topical authority in editorial cricket, had severe Core Web Vitals latency, and had zero programmatic architecture to cover hundreds of live fixtures.",strategy:["Engineered an automated programmatic SEO architecture creating dedicated fixture, squad, and match prediction pages automatically.","Conducted a comprehensive Core Web Vitals sprint, reducing LCP by 40% through lazy-loading, asset minimization, and CDN caching.","Implemented comprehensive BreadcrumbList, SportsEvent, and FAQPage structured data to capture rich interactive SERP carousels.","Ran 20+ App Store Optimization A/B tests across India, US, and Brazil, optimizing creative assets and keyword targeting."],results:[{label:"Organic Traffic",value:"0 to 130K+",detail:"Achieved in just 90 days from project kickoff"},{label:"Core Web Vitals",value:"92+ Score",detail:"All core pages transitioned to Google 'Good' threshold"},{label:"App Store Installs",value:"+34% Lift",detail:"Conversion rate lift following localized creative A/B testing"}],tags:["Programmatic SEO","Core Web Vitals","Gaming & Fantasy Sports","ASO","Schema.org"]},{id:"internshala-pseo",company:"Internshala",tagline:"Scaling 10,000+ Programmatic Landing Pages Across Double-Sided Marketplace",metricHero:"10,000+",metricLabel:"Programmatic Pages Scaled",timeframe:"Jan 2026 - June 2026",overview:"Internshala required a scalable search engine strategy to capture long-tail student career queries while simultaneously driving high-intent employer signups.",problem:"Manual page creation could not keep pace with thousands of permutation queries (e.g. 'work from home python internship in bangalore'), causing massive missed demand.",strategy:["Designed a database-driven Programmatic SEO framework dynamically generating high-value category, location, and skill landing pages.","Restructured platform taxonomy and internal linking hubs to ensure Googlebot crawled and indexed new job postings within minutes.","Optimized content funnels for hackathons, student competitions, and blog hubs through comprehensive semantic keyword clusters.","Refined mobile app metadata and keyword banks on Google Play & App Store to maximize organic student discoverability."],results:[{label:"Crawl Efficiency",value:"3.5x Faster",detail:"Googlebot indexing speed for dynamic listings"},{label:"pSEO Landing Pages",value:"10K+ Ranked",detail:"Targeting high-intent non-branded student searches"},{label:"Organic App Downloads",value:"+28% YoY",detail:"Driven by synchronized web-to-app and ASO optimization"}],tags:["Marketplace SEO","Programmatic Architecture","Crawl Budget","B2B & B2C Funnels","ASO"]},{id:"giva-jewellery",company:"GIVA Jewellery",tagline:"Architecting E-Commerce Category Authority for Omnichannel Fine Jewellery",metricHero:"Top 3",metricLabel:"Rankings for Commercial Silver Jewellery",timeframe:"July 2026 - Present",overview:"Managing search strategy for India's foremost fine silver and lab-grown diamond brand, focusing on high-converting collection pages and transactional queries.",problem:"High category competition, complex facet URLs creating duplicate content, and need for authoritative e-commerce buyer guides that drive high AOV orders.",strategy:["Designed clean multi-tier collection page taxonomy separating core metal categories, styling motifs, and recipient gift intent.","Deployed automated category guide generators providing bespoke styling tips, sizing advice, and care instructions without generic filler.","Implemented strict canonicalization and noindex protocols on facet filter combinations to preserve crawl budget.","Integrated Merchant Center structured data to dominate Google Shopping tabs and commercial visual SERP features."],results:[{label:"Category Visibility",value:"#1 to #3",detail:"Dominating high-volume commercial jewellery queries"},{label:"Crawl Cleanliness",value:"Zero Bloat",detail:"100% elimination of indexable filter duplicate URLs"},{label:"Internal Link Equity",value:"+45% Boost",detail:"Streamlined link flow from collection guides to high-margin SKUs"}],tags:["E-Commerce SEO","Omnichannel Luxury","Collection Architecture","Merchant Data","Category Guides"]},{id:"sportskeeda-discover",company:"Sportskeeda",tagline:"Dominating Real-Time Google Discover Feeds and Google News Carousels",metricHero:"+25%",metricLabel:"Organic Traffic Surge Across Sports Categories",timeframe:"Jan 2024 - Jan 2025",overview:"Optimizing high-frequency sports publishing during international tournaments to secure immediate indexing and massive Discover carousel visibility.",problem:"Content lifespan in sports is measured in minutes; traditional SEO indexing was too slow to capture trending tournament spikes.",strategy:["Optimized live event schema and editorial templates for lightning-fast Google News ingestion.","Engineered high-CTR image framing and entity-centric headline guidelines specifically calibrated for Google Discover algorithms.","Executed technical health audits, resolving redirect chains and 404 dead-ends across dynamic category hubs.","Monitored real-time Google Search Console and Google Analytics 4 performance metrics to capitalize on trending player queries."],results:[{label:"Traffic Surge",value:"+25% Overall",detail:"Sustained traffic increase across primary sports verticals"},{label:"Google Discover",value:"5M+ Views",detail:"Captured across peak international sporting championships"},{label:"Indexing Latency",value:"< 2 Minutes",detail:"Real-time Google News crawler ingestion speed"}],tags:["Google Discover","Google News","Real-Time SEO","Editorial Link Building","Technical Audit"]}],Wu=[{name:"SEMrush",category:"SEO & Crawling",description:"Competitor gap analysis, keyword tracking & domain authority benchmarking",icon:"Search",proficiency:98},{name:"Ahrefs",category:"SEO & Crawling",description:"Backlink profile auditing, Content Explorer, and SERP volatility analysis",icon:"Link2",proficiency:96},{name:"Screaming Frog",category:"SEO & Crawling",description:"Deep technical site crawls, rendering diagnostics, and status code debugging",icon:"Cpu",proficiency:95},{name:"Surfer SEO",category:"SEO & Crawling",description:"Semantic entity clustering and NLP on-page content correlation",icon:"FileText",proficiency:92},{name:"Sensor Tower",category:"App Store (ASO)",description:"App keyword intelligence, download estimations & category rankings",icon:"Smartphone",proficiency:94},{name:"App Radar",category:"App Store (ASO)",description:"ASO metadata optimization, competitor keyword monitoring & A/B testing",icon:"Radar",proficiency:92},{name:"AppsFlyer",category:"App Store (ASO)",description:"Attribution tracking, deep-linking, and user journey LTV analysis",icon:"Activity",proficiency:90},{name:"Google Search Console",category:"Analytics & GSC",description:"Index coverage diagnostics, crawl stats, search performance & schema testing",icon:"Terminal",proficiency:99},{name:"Google Analytics 4",category:"Analytics & GSC",description:"Custom event funnels, conversion tracking, and user acquisition pathing",icon:"BarChart3",proficiency:96},{name:"Looker Studio",category:"Analytics & GSC",description:"Executive automated reporting dashboards connecting GSC, GA4 & BigQuery",icon:"PieChart",proficiency:95},{name:"PageSpeed Insights",category:"Analytics & GSC",description:"Field and lab Core Web Vitals (LCP, INP, CLS) performance diagnosis",icon:"Gauge",proficiency:97},{name:"LLM Tracking & GEO Tools",category:"AI & LLM Tech",description:"Monitoring brand citations and prompt outputs across ChatGPT, Gemini & Perplexity",icon:"Bot",proficiency:94}],Sp=[{q:"How does Generative Engine Optimization (GEO) differ from traditional SEO?",a:"Traditional SEO focuses on earning blue links on Google's search result pages through keyword density, backlinks, and technical markup. GEO (Generative Engine Optimization) optimizes your brand so AI models (ChatGPT, Gemini, Claude, Perplexity) retrieve, understand, and cite your brand when answering conversational buyer queries. It requires entity authority in the Knowledge Graph, machine-readable documentation like /llms.txt, and unambiguous structured schema."},{q:"What makes Programmatic SEO (pSEO) safe from Google's Helpful Content penalties?",a:"Google penalizes programmatic sites that produce thin, boilerplate, low-value pages with spun text. Safe, high-ranking pSEO requires proprietary structured datasets, genuinely helpful unique modules on every URL (such as interactive calculators, sizing charts, or contextual reviews), clean internal linking, and strict canonicalization. That is the exact engineering framework I deployed at Internshala and MPL."},{q:"How quickly can we expect to see measurable results from a consulting engagement?",a:"Technical fixes, crawl budget cleanups, and schema corrections often yield indexation and ranking improvements within 3 to 6 weeks. Programmatic SEO deployments and comprehensive GEO authority compounding generally reach full velocity within 60 to 90 days as search engines and LLM crawlers recrawl and digest the new entity graph."},{q:"Do you collaborate directly with internal engineering and content teams?",a:"Yes. With a B.Tech in Information Technology, I speak the language of developers. Rather than handing over vague 80-page PDF reports, I write actionable GitHub/Jira tickets, PR review suggestions, and clean structured data code that developers can implement immediately."},{q:"Can you help with both Website SEO and Mobile App ASO?",a:"Absolutely. Modern consumer brands cannot afford to silo web and app acquisition. Having managed both at MPL and Internshala, I synchronize your web search authority with App Store & Google Play metadata, driving seamless web-to-app conversion loops and maximizing organic installs."}],Np=[{quote:"Venkatesh combines technical engineering rigor with an instinct for what search algorithms actually reward. His execution on programmatic cricket verticals at MPL was exceptional—taking a new section to 130K+ visits in 3 months.",author:"Product & Growth Lead",title:"Mobile Premier League (MPL)",rating:5},{quote:"Scaling programmatic landing pages across thousands of student permutations requires meticulous taxonomy. Venkatesh structured our search architecture so cleanly that indexation was virtually immediate.",author:"VP of Digital Acquisition",title:"Internshala",rating:5},{quote:"In the fast-evolving e-commerce landscape, having someone who understands both commercial user intent and technical facet control is rare. Venkatesh is a true growth asset.",author:"Marketing & Growth Director",title:"GIVA Jewellery",rating:5}],Cp=({onOpenBooking:g})=>{const[w,m]=te.useState(!1),[z,S]=te.useState(!1);return te.useEffect(()=>{const P=()=>{m(window.scrollY>20)};return window.addEventListener("scroll",P),()=>window.removeEventListener("scroll",P)},[]),i.jsxs("header",{className:`fixed top-0 left-0 right-0 z-50 transition-all duration-300 ${w?"bg-[#070a12]/90 backdrop-blur-xl border-b border-white/10 shadow-2xl shadow-black/40 py-3":"bg-transparent py-5"}`,children:[i.jsx("div",{className:"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8",children:i.jsxs("div",{className:"flex items-center justify-between",children:[i.jsxs("a",{href:"#",className:"flex items-center gap-3 group",children:[i.jsx("div",{className:"w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-cyan-500 p-0.5 shadow-lg shadow-emerald-500/20 group-hover:scale-105 transition-transform",children:i.jsx("div",{className:"w-full h-full bg-[#070a12] rounded-[10px] flex items-center justify-center font-bold text-white tracking-wider text-sm",children:"VR"})}),i.jsxs("div",{children:[i.jsxs("div",{className:"font-bold text-white text-base tracking-tight group-hover:text-emerald-400 transition-colors flex items-center gap-1.5",children:[i.jsx("span",{children:"Ramavath Venkatesh"}),i.jsx("span",{className:"hidden sm:inline-block px-1.5 py-0.5 rounded text-[10px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-mono",children:"SEO & ASO"})]}),i.jsxs("p",{className:"text-[11px] text-slate-400 flex items-center gap-1.5",children:[i.jsx("span",{className:"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"}),i.jsx("span",{children:"Lead SEO @ GIVA Jewellery"})]})]})]}),i.jsxs("nav",{className:"hidden lg:flex items-center gap-1 bg-slate-900/60 p-1.5 rounded-full border border-white/10 shadow-inner",children:[i.jsx("a",{href:"#services",className:"px-3.5 